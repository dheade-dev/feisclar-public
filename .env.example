# GitHub Personal Access Token for release publishing
# Generate at: https://github.com/settings/tokens
# Classic token: 'public_repo' or 'repo'
# Fine-grained token: repository 'feisclar-public', Permissions -> 'Contents: Read and write'
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Optional overrides:
# GITHUB_REPO=dheade-dev/feisclar-public
# RELEASE_TAG=0.3
